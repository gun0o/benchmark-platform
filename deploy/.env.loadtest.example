# Copy to deploy/.env.loadtest and pass with --env-file for the M5.4 load-test profile.
#
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env.loadtest up -d --wait
#
# The only difference from the default profile is durability: synchronous_commit=off lets
# Postgres acknowledge a commit before the WAL reaches the disk. It raises ingest
# throughput and it can lose the last few transactions on a crash, which is acceptable for
# a benchmark database and not for anything else. Any k6 number produced under this
# profile is recorded as such.
POSTGRES_USER=bench
POSTGRES_PASSWORD=bench
POSTGRES_DB=bench
POSTGRES_PORT=5432
REDIS_PORT=6379
PG_SHARED_BUFFERS=512MB
PG_WORK_MEM=32MB
PG_EFFECTIVE_CACHE_SIZE=4GB
PG_MAX_CONNECTIONS=200
PG_SYNCHRONOUS_COMMIT=off
DATABASE_URL=postgres://bench:bench@localhost:5432/bench?sslmode=disable
REDIS_URL=redis://localhost:6379/0
API_ADDR=:8080
PG_MAX_CONNS=20
