# Copy to deploy/.env (git-ignored). Compose reads it automatically because the
# project directory is deploy/. The Go API and scripts read the same names.

POSTGRES_USER=bench
POSTGRES_PASSWORD=bench
POSTGRES_DB=bench
POSTGRES_PORT=5432
REDIS_PORT=6379

# Used by the API (native or in compose). Inside compose the host names are
# "postgres" and "redis"; from WSL they are localhost.
DATABASE_URL=postgres://bench:bench@localhost:5432/bench?sslmode=disable
REDIS_URL=redis://localhost:6379/0
API_ADDR=:8080
